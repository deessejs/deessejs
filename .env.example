# ============================================================================
# One source of truth for all env vars across the monorepo.
#
# Copy this file to `.env` at the repo root:
#   cp .env.example .env
#
# The schema is validated by `packages/env/src/schema.ts`. Anything missing or
# invalid fails fast at the first import of `@workspace/env/server`.
#
# Required:
#   - DATABASE_URL          Postgres connection string
#   - BETTER_AUTH_SECRET    >= 32 chars. Generate: openssl rand -base64 32
#
# Optional (defaults shown):
#   - BETTER_AUTH_URL       defaults to http://localhost:3000. Legacy
#                           single-origin reference for tooling
#                           (drizzle-kit, scripts). The auth handler
#                           resolves the per-request origin via the
#                           dynamic `baseURL: { allowedHosts }` form
#                           in packages/auth/src/auth.ts. See
#                           packages/auth/src/host-allowlist.ts for
#                           the rationale.
#   - ALLOWED_ORIGINS       CSV. Wildcard `*.vercel.app` is accepted at
#                           the Hono CORS layer regardless via
#                           @workspace/auth/host-allowlist.
#                           Set this for ad-hoc staging / partner origins.
#   - TEST_DATABASE_URL     falls back to DATABASE_URL when unset
#   - AUTH_SECRET           alias for BETTER_AUTH_SECRET
#
# Inter-app URLs: one server var and one client mirror per app.
# Each var carries one role; consumers import the role they need
# directly.
#
# Client-safe (NEXT_PUBLIC_*) are inlined at build time into browser bundles.
# ============================================================================

# ============================================================================
# Database
# ============================================================================
DATABASE_URL=postgresql://user:password@localhost:5432/saas

# ============================================================================
# better-auth (server-side)
# ============================================================================
BETTER_AUTH_SECRET=                   # Run: openssl rand -base64 32
AUTH_SECRET=                          # Alias fallback for BETTER_AUTH_SECRET
BETTER_AUTH_URL=http://localhost:3000 # Legacy single-origin reference (see packages/auth/src/host-allowlist.ts and the baseURL block in packages/auth/src/auth.ts)

# Comma-separated list of allowed CORS origins (including protocol).
# The wildcard `*.vercel.app` is accepted by the Hono CORS layer
# regardless via @workspace/auth/host-allowlist (apex entries are
# load-bearing).
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Bare hostname for cross-subdomain session cookie (e.g. deessejs.com).
# Required in production for the cross-subdomain cookie to scope
# correctly.
PARENT_DOMAIN=

# ============================================================================
# Inter-app URLs (server-side)
# ============================================================================
# Marketing canonical: apps/web's own origin. Set on every Vercel project
# that reads it. Production: https://deessejs.com
WEB_URL=http://localhost:3000

# apps/app's origin, used by apps/app when it self-references. Production:
# https://app.deessejs.com. Hardcoded as auth backend fallback in
# packages/auth/src/auth.ts.
APP_URL=http://localhost:3001

# apps/docs origin, used by cross-app links pointing
# at docs. Production: https://docs.deessejs.com.
DOCS_URL=http://localhost:3002

# API backend origin as seen by the same-origin Node runtime (the proxy in
# apps/app fetches `/api/v1/auth/get-session` against this host).
# Today equal to APP_URL; will diverge if the API is split from
# apps/app.
API_BASE_URL=http://localhost:3001

# ============================================================================
# Client-side (NEXT_PUBLIC_*: safe to commit, values are public)
# ============================================================================
NEXT_PUBLIC_APP_NAME=DeesseJS
NEXT_PUBLIC_APP_DESCRIPTION=SaaS application built with Next.js and shared UI components

# Inter-app URL mirrors: one per role. The apps/web marketing
# canonical is `NEXT_PUBLIC_WEB_URL`; the apps/app origin is
# `NEXT_PUBLIC_APP_URL`. `NEXT_PUBLIC_API_BASE_URL` is the API origin
# as seen by clients (today equal to APP_URL). Do not alias these,
# each var carries one role.
NEXT_PUBLIC_WEB_URL=http://localhost:3000     # Marketing canonical
NEXT_PUBLIC_APP_URL=http://localhost:3001     # apps/app origin
NEXT_PUBLIC_DOCS_URL=http://localhost:3002    # apps/docs origin
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001 # API origin (client-side)

# ============================================================================
# CLI (apps/cli): override for end users running the published tarball
# ============================================================================
# Primary env var consumed by `apps/cli/src/api/client.ts`,
# `apps/cli/src/lib/auth/store/better-auth-client.ts`, and
# `apps/cli/src/version/check.ts`. Default fallback is hardcoded to
# `https://app.deessejs.com` in each of those three sites because
# the published tarball cannot depend on the private
# `@workspace/env` package.
DEESSEJS_API_URL=

# Companion var. Opt-in for pointing the CLI at a specific Vercel
# preview during local testing. Has no default; unset means "use
# the hardcoded production default."
DEESSEJS_PREVIEW_API_URL=

# ============================================================================
# Mailer (transport selector)
# ============================================================================
#   "console" (default) → logs to stdout, zero infrastructure
#   "resend"            → production, uses RESEND_API_KEY below
MAIL_TRANSPORT=console

# ============================================================================
# Mailer (Resend, production)
# ============================================================================
# Get an API key at https://resend.com/api-keys
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
RESEND_FROM_NAME="DeesseJS"

# ============================================================================
# Playbook marketing opt-in (Resend Topic)
# ============================================================================
# Create the Topic in the Resend dashboard (Audience, Topics) and paste
# its id here. It names the subscription preference the /playbook consent
# checkbox opts into, e.g. "DeesseJS updates".
# Required in production: without it the checkbox has nowhere to record
# the opt-in.
RESEND_PLAYBOOK_TOPIC_ID=

# ============================================================================
# GitHub OAuth (sign-in with GitHub)
# ============================================================================
# Optional. Leave blank to keep "Continue with GitHub" a server-side failure
# (better-auth will error at request time). Set both keys to enable.
#
# Create an OAuth App at https://github.com/settings/developers
#   - Authorization callback URL: http://localhost:3000/api/auth/callback/github
#     (production: https://<your-domain>/api/auth/callback/github)
#
# IMPORTANT: the `user:email` scope is configured on the GitHub OAuth App side
# (Permissions > Account Permissions > Email Addresses > Read-only), NOT here.
# Adding `scope` to the better-auth config would duplicate upstream and drift.
#
# Without GITHUB_CLIENT_* set, the existing UI button at /login and /signup
# still renders: it just bounces the user back with an opaque error.
# Server fails loud; UI does not pretend to know.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Analytics provider: "none" (default) or "vercel". Collection also requires consent.
NEXT_PUBLIC_ANALYTICS_PROVIDER=none
# Optional Vercel Analytics project ID; omit to use the active Vercel project.
# Optional Vercel Analytics data source name (DSN).
# NEXT_PUBLIC_VERCEL_ANALYTICS_DSN=
