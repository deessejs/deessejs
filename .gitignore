# Dependencies
node_modules/
**/.turbo/
/apps/*/dist/
/packages/*/dist/
/apps/*/.next/

# Local development secrets, generated sessions, and per-worktree state
.env.local
.env.*.local
.local/

# Local Vale scratch files
B-RULES.txt
B-VIOLATIONS.txt

# Vale-synced package styles (downloaded by `vale sync` into $StylesPath;
# the CI workflow syncs these on the fly from the cache, not from git).
.github/styles/Microsoft/
.github/styles/write-good/
.github/styles/proselint/

# Playwright artifacts. The e2e suite writes traces, screenshots and
# the HTML report here on every run (apps/web/tests/e2e/test-results),
# and the CI preset writes the HTML report to its own path.
apps/web/tests/e2e/test-results/
apps/web/playwright-report/

# CodeGraph local index and database
.codegraph/

# Example-local generated Deesse and Better Auth schema tooling
examples/next-shadcn-monorepo/apps/web/.deesse/
