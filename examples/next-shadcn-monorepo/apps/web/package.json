{
  "name": "@deesse-example/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "pnpm run schema:generate && next build",
    "start": "next start",
    "lint": "pnpm --dir ../../../../ exec oxlint --config .oxlintrc.json examples/next-shadcn-monorepo --deny-warnings",
    "typecheck": "pnpm run schema:generate && tsc --noEmit",
    "schema:generate": "pnpm run deesse:schema && pnpm run auth:schema",
    "auth:schema": "pnpm exec auth generate --config ./.deesse/tooling/auth.config.ts --adapter drizzle --dialect postgresql --output ./src/server/database/schema/auth.ts --yes",
    "deesse:schema": "node ../../../../apps/deesse-drizzle-adapter/dist/cli.js --plugins ./plugins/index.ts --config ./deesse.config.ts --output ./src/server/database/schema/deesse.ts --auth-config-output ./.deesse/tooling/auth.config.ts --auth-schema-placeholder-output ./src/server/database/schema/auth.ts",
    "db:generate": "pnpm exec drizzle-kit generate --config ./drizzle.config.ts",
    "db:migrate": "pnpm exec drizzle-kit migrate --config ./drizzle.config.ts"
  },
  "dependencies": {
    "@deessejs/drizzle-adapter": "workspace:*",
    "@deesse-example/ui": "workspace:*",
    "@orpc/server": "catalog:",
    "better-auth": "catalog:",
    "deesse": "workspace:*",
    "dotenv": "catalog:",
    "drizzle-orm": "catalog:",
    "next": "catalog:",
    "postgres": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@workspace/typescript-config": "workspace:*",
    "auth": "catalog:",
    "drizzle-kit": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:"
  }
}
