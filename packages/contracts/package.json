{
  "name": "@workspace/contracts",
  "version": "0.0.1",
  "private": false,
  "description": "Workspace-only shared contract package. Marked private:false so Changesets accepts it as a regular versioned dependency of @deessejs/cli. Do NOT add a publish workflow — this package is consumed only inside the monorepo.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./v1": {
      "types": "./dist/v1/index.d.ts",
      "import": "./dist/v1/index.js",
      "default": "./dist/v1/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "scripts": {
    "lint": "eslint --max-warnings=0",
    "build": "tsc",
    "test": "vitest",
    "test:run": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "eslint": "catalog:",
    "vitest": "catalog:"
  }
}
