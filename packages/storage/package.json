{
  "name": "@workspace/storage",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./errors": {
      "types": "./dist/errors.d.ts",
      "import": "./dist/errors.js",
      "default": "./dist/errors.js"
    },
    "./envelope": {
      "types": "./dist/envelope.d.ts",
      "import": "./dist/envelope.js",
      "default": "./dist/envelope.js"
    },
    "./provider": {
      "types": "./dist/provider.d.ts",
      "import": "./dist/provider.js",
      "default": "./dist/provider.js"
    },
    "./providers/git-tags": {
      "types": "./dist/providers/git-tags.d.ts",
      "import": "./dist/providers/git-tags.js",
      "default": "./dist/providers/git-tags.js"
    },
    "./resolve": {
      "types": "./dist/resolve.d.ts",
      "import": "./dist/resolve.js",
      "default": "./dist/resolve.js"
    }
  },
  "types": "./dist/index.d.ts",
  "scripts": {
    "lint": "eslint --max-warnings=0",
    "build": "tsc",
    "test": "vitest",
    "test:run": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@workspace/contracts": "workspace:*",
    "tar-stream": "3.2.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/tar-stream": "3.1.4",
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "@workspace/vitest-config": "workspace:*",
    "eslint": "catalog:",
    "vitest": "catalog:"
  }
}
