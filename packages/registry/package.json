{
  "name": "@workspace/registry",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./v1": {
      "types": "./dist/v1/index.d.ts",
      "import": "./dist/v1/index.js",
      "default": "./dist/v1/index.js"
    },
    "./schema/template/v1.json": "./schema/template/v1.json"
  },
  "types": "./dist/index.d.ts",
  "scripts": {
    "lint": "eslint --max-warnings=0",
    "build": "tsc",
    "schema:generate": "node --experimental-strip-types scripts/generate-template-schema.mjs",
    "schema:check": "node --experimental-strip-types scripts/generate-template-schema.mjs --check",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "eslint": "catalog:",
    "typescript": "catalog:"
  }
}
