{
  "name": "@workspace/registry",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./v1": {
      "types": "./dist/v1/index.d.ts",
      "import": "./dist/v1/index.js",
      "default": "./dist/v1/index.js"
    },
    "./schema/template/v1.json": "./schema/template/v1.json",
    "./schema/block/v1.json": "./schema/block/v1.json",
    "./schema/project/v1.json": "./schema/project/v1.json"
  },
  "types": "./dist/index.d.ts",
  "scripts": {
    "lint": "pnpm --dir ../../ exec oxlint --config .oxlintrc.json packages/registry --deny-warnings",
    "build": "tsc",
    "schema:generate": "node --experimental-strip-types scripts/generate-template-schema.mjs",
    "schema:check": "node --experimental-strip-types scripts/generate-template-schema.mjs --check",
    "block-schema:generate": "node --experimental-strip-types scripts/generate-block-schema.mjs",
    "block-schema:check": "node --experimental-strip-types scripts/generate-block-schema.mjs --check",
    "test": "vitest",
    "test:run": "vitest run",
    "typecheck": "tsc --noEmit",
    "project-schema:generate": "node --experimental-strip-types scripts/generate-project-schema.mjs",
    "project-schema:check": "node --experimental-strip-types scripts/generate-project-schema.mjs --check"
  },
  "dependencies": {
    "picomatch": "catalog:",
    "tar": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/picomatch": "catalog:",
    "@workspace/typescript-config": "workspace:*",
    "vitest": "catalog:",
    "@workspace/vitest-config": "workspace:*",
    "typescript": "catalog:",
    "oxlint": "catalog:"
  }
}
