{
  "name": "@workspace/auth",
  "version": "0.0.2",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/auth.d.ts",
      "import": "./dist/auth.js",
      "default": "./dist/auth.js"
    },
    "./host-allowlist": {
      "types": "./dist/host-allowlist.d.ts",
      "import": "./dist/host-allowlist.js",
      "default": "./dist/host-allowlist.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js",
      "default": "./dist/types.js"
    }
  },
  "types": "./dist/auth.d.ts",
  "scripts": {
    "lint": "eslint --max-warnings=0",
    "build": "tsc",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "auth:generate": "echo 'auth:generate is disabled — see the long-form comment at the top of packages/database/src/schema/auth.ts. The current auth CLI versions (1.4.22 and 1.6.23) silently rename the deviceCode table to device_code and drop its unique constraints / FK / indexes / created_at+updated_at columns / status default / pollingInterval bigint type, breaking every device-flow endpoint. Edit the schema by hand until the upstream CLI is fixed.' && exit 1"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "catalog:",
    "@workspace/database": "workspace:*",
    "@workspace/email": "workspace:*",
    "@workspace/env": "workspace:*",
    "better-auth": "catalog:",
    "drizzle-orm": "catalog:",
    "pg": "catalog:",
    "postgres": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "@workspace/vitest-config": "workspace:*",
    "auth": "catalog:",
    "eslint": "catalog:",
    "vitest": "catalog:"
  }
}
