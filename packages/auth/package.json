{
  "name": "@workspace/auth",
  "version": "0.0.2",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/auth.d.ts",
      "import": "./dist/auth.js",
      "default": "./dist/auth.js"
    },
    "./host-allowlist": {
      "types": "./dist/host-allowlist.d.ts",
      "import": "./dist/host-allowlist.js",
      "default": "./dist/host-allowlist.js"
    },
    "./organization/policy": {
      "types": "./dist/organization/policy.d.ts",
      "import": "./dist/organization/policy.js",
      "default": "./dist/organization/policy.js"
    },
    "./organization/invitation": {
      "types": "./dist/organization/invitation.d.ts",
      "import": "./dist/organization/invitation.js",
      "default": "./dist/organization/invitation.js"
    },
    "./organization/roles": {
      "types": "./dist/organization/roles.d.ts",
      "import": "./dist/organization/roles.js",
      "default": "./dist/organization/roles.js"
    },
    "./organization/reserved-slugs": {
      "types": "./dist/organization/reserved-slugs.d.ts",
      "import": "./dist/organization/reserved-slugs.js",
      "default": "./dist/organization/reserved-slugs.js"
    },
    "./organization/provisioning": {
      "types": "./dist/organization/provisioning.d.ts",
      "import": "./dist/organization/provisioning.js",
      "default": "./dist/organization/provisioning.js"
    },
    "./organization/create": {
      "types": "./dist/organization/create.d.ts",
      "import": "./dist/organization/create.js",
      "default": "./dist/organization/create.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js",
      "default": "./dist/types.js"
    }
  },
  "types": "./dist/auth.d.ts",
  "scripts": {
    "lint": "pnpm --dir ../../ exec oxlint --config .oxlintrc.json packages/auth --deny-warnings",
    "build": "tsc",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "auth:generate": "auth generate --config src/auth.ts --adapter drizzle --dialect postgresql --output ../../packages/database/src/schema/auth.ts --yes"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "catalog:",
    "@workspace/database": "workspace:*",
    "@workspace/email": "workspace:*",
    "@workspace/env": "workspace:*",
    "better-auth": "catalog:",
    "drizzle-orm": "catalog:",
    "pg": "catalog:",
    "postgres": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "@workspace/typescript-config": "workspace:*",
    "@workspace/vitest-config": "workspace:*",
    "auth": "catalog:",
    "vitest": "catalog:",
    "oxlint": "catalog:"
  }
}
