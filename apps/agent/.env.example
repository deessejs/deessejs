# Provider key for the MiniMax M3 model.
# The package `vercel-minimax-ai-provider` reads this env var.
MINIMAX_API_KEY=

# GitHub App credentials (bring-your-own).
# Create the App at https://github.com/settings/apps/new.
# Webhook URL: https://<your-vercel-deployment>/eve/v1/github
# Webhook secret: any random string; paste the same value here.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# Fine-grained PAT used by the GitHub tools extension
# (`@github-tools/eve-extension`) for read and write calls.
# Required scopes:
#   - Contents: Read
#   - Issues: Read & write
#   - Pull requests: Read & write
#   - Metadata: Read-only
# The extension's `token` option falls back to this env var when set.
# Generate one at https://github.com/settings/tokens?type=beta.
GITHUB_TOKEN=
