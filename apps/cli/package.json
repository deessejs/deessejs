{
  "name": "@deessejs/cli",
  "version": "2.1.0",
  "description": "CLI for the DeesseJS template registry and blocks.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deessejs/deessejs.git"
  },
  "keywords": [
    "cli",
    "deessejs",
    "deessejs-main-app",
    "scaffolding"
  ],
  "private": false,
  "bin": {
    "deessejs": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "files": [
    "dist",
    "README.md",
    "../../LICENSE"
  ],
  "scripts": {
    "prebuild": "pnpm --filter @workspace/contracts build && pnpm --filter @workspace/registry build",
    "build": "tsup",
    "predev": "pnpm --filter @workspace/contracts build && pnpm --filter @workspace/registry build",
    "dev": "tsup --watch",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "typecheck": "tsc --noEmit",
    "typecheck:e2e": "tsc --noEmit -p tsconfig.e2e.json",
    "pretest": "pnpm turbo build --filter=@deessejs/cli && tsup",
    "test": "vitest run",
    "test:e2e": "vitest run --config test/e2e/vitest.e2e.config.ts",
    "test:watch": "vitest",
    "start": "node ./dist/index.js"
  },
  "dependencies": {
    "@deessejs/errors": "^1.1.1",
    "@deessejs/fp": "^1.0.0",
    "@orpc/client": "^1.14.7",
    "@orpc/server": "^1.14.7",
    "better-auth": "^1.7.7",
    "commander": "^12.1.0",
    "cross-spawn": "catalog:",
    "open": "^11.0.1",
    "ora": "^8.1.1",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@workspace/api": "workspace:*",
    "@workspace/contracts": "workspace:*",
    "@workspace/registry": "workspace:*",
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "eslint": "^9",
    "prettier": "^3.9.4",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "tar": "catalog:",
    "tsup": "^8.3.5",
    "typescript": "catalog:",
    "vitest": "^2.1.5"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
