{
  "name": "@workspace/docs",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "pnpm --dir ../../ exec oxlint --config .oxlintrc.json apps/docs",
    "format": "oxfmt --config ../../.oxfmtrc.json --ignore-path ../../.oxfmtignore \"**/*.{ts,tsx,mdx}\"",
    "typecheck": "fumadocs-mdx && next typegen && tsc --noEmit"
  },
  "dependencies": {
    "@workspace/analytics": "workspace:*",
    "@workspace/cookies": "workspace:*",
    "@workspace/ui": "workspace:*",
    "cnfast": "^0.0.8",
    "fumadocs-core": "^16.14.5",
    "fumadocs-mdx": "^15.4.3",
    "fumadocs-ui": "^16.14.5",
    "lucide-react": "catalog:",
    "next": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "catalog:",
    "@types/mdx": "^2.0.14",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@workspace/typescript-config": "workspace:*",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "postcss": "^8.5.15",
    "tailwindcss": "^4",
    "typescript": "catalog:"
  }
}
