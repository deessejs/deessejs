{
  "name": "deesse",
  "version": "0.4.0",
  "description": "DeesseJS server framework core and typed React client.",
  "license": "MIT",
  "keywords": [
    "deessejs",
    "framework",
    "hono",
    "better-auth",
    "orpc"
  ],
  "type": "module",
  "files": [
    "dist",
    "src/plugins/admin/styles.css",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/deessejs/deessejs.git",
    "directory": "apps/deesse"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js",
      "default": "./dist/react.js"
    },
    "./next": {
      "types": "./dist/next.d.ts",
      "import": "./dist/next.js",
      "default": "./dist/next.js"
    },
    "./plugins/blog": {
      "types": "./dist/plugins/blog/index.d.ts",
      "import": "./dist/plugins/blog/index.js",
      "default": "./dist/plugins/blog/index.js"
    },
    "./plugins/blog/admin": {
      "types": "./dist/plugins/blog/admin/index.d.ts",
      "import": "./dist/plugins/blog/admin/index.js",
      "default": "./dist/plugins/blog/admin/index.js"
    },
    "./plugins/admin": {
      "types": "./dist/plugins/admin/index.d.ts",
      "import": "./dist/plugins/admin/index.js",
      "default": "./dist/plugins/admin/index.js"
    },
    "./plugins/admin/next": {
      "types": "./dist/plugins/admin/next.d.ts",
      "import": "./dist/plugins/admin/next.js",
      "default": "./dist/plugins/admin/next.js"
    },
    "./plugins/admin/styles.css": {
      "default": "./src/plugins/admin/styles.css"
    }
  },
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc --noEmit -p tsconfig.consumer.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "pnpm --dir ../.. exec oxlint --config .oxlintrc.json apps/deesse --deny-warnings",
    "test": "vitest run"
  },
  "dependencies": {
    "@deessejs/errors": "catalog:",
    "@deessejs/fp": "catalog:",
    "@orpc/client": "catalog:",
    "@orpc/server": "catalog:",
    "better-auth": "catalog:",
    "hono": "catalog:",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "@deessejs/ui": "catalog:",
    "next": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "peerDependenciesMeta": {
    "@deessejs/ui": { "optional": true },
    "next": { "optional": true },
    "react": { "optional": true },
    "react-dom": { "optional": true }
  },
  "devDependencies": {
    "@better-auth/memory-adapter": "catalog:",
    "@workspace/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@deessejs/ui": "workspace:*",
    "next": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
