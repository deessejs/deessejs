{
  "name": "create-deesse-app",
  "version": "0.0.0",
  "private": false,
  "description": "Initialize a new DeesseJS project from the current main of deessejs/saas-template.",
  "keywords": [
    "cli",
    "create-app",
    "deessejs",
    "scaffolding"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deessejs/deessejs.git"
  },
  "bin": {
    "create-deesse-app": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "../../LICENSE"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "pnpm --dir ../../ exec oxlint --config .oxlintrc.json apps/create-deesse-app",
    "format": "oxfmt --config ../../.oxfmtrc.json --ignore-path ../../.oxfmtignore \"**/*.{ts,tsx,json,md}\"",
    "typecheck": "tsc --noEmit",
    "typecheck:unit": "tsc --noEmit -p tsconfig.unit.json",
    "typecheck:e2e": "tsc --noEmit -p tsconfig.e2e.json",
    "test": "vitest run",
    "test:e2e": "vitest run --config test/e2e/vitest.e2e.config.ts",
    "test:watch": "vitest",
    "start": "node ./dist/index.js"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "cross-spawn": "catalog:",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@playwright/test": "catalog:",
    "@types/node": "catalog:",
    "@workspace/typescript-config": "workspace:*",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "tar": "catalog:",
    "testcontainers": "^12.0.0",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
