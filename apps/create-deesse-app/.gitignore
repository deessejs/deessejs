dist/
node_modules/

# Build artifacts from `pnpm pack`. Both release.yml and publish-verify.yml
# pack into this directory, so without this rule every pack leaves an
# untracked tarball that looks committable. A 0.0.0 tarball was committed here
# by accident before the rule existed.
*.tgz

# Generated by the native smoke test (test/e2e/smoke/) when the
# harness runs the CLI without an explicit --dir. The CLI defaults
# the destination to ./<project-name>, so without this guard the
# starter template would land in the package root on every run.
smoke-project/