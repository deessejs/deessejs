{
  "name": "deessejs",
  "version": "0.0.1",
  "private": true,
  "description": "DeesseJS main app — the monorepo that powers the deessejs organization.",
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "pnpm lint:directives && pnpm lint:type-assertions && pnpm lint:guard && turbo lint -- --max-warnings=0",
    "format": "turbo format",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "db:generate": "pnpm --filter @workspace/database db:generate",
    "db:migrate": "pnpm --filter @workspace/database db:migrate",
    "db:push": "pnpm --filter @workspace/database db:push",
    "db:studio": "pnpm --filter @workspace/database db:studio",
    "auth:generate": "pnpm --filter @workspace/auth auth:generate",
    "env:check": "node --experimental-strip-types scripts/env-check.ts",
    "lint:directives": "node scripts/check-lint-directives.mjs",
    "lint:type-assertions": "node scripts/lint-type-assertions.mjs",
    "lint:guard": "pnpm exec oxlint --config .oxlintrc.json scripts/check-lint-directives.mjs --max-warnings=0",
    "dedupe:check": "pnpm dedupe --check",
    "complex:collect": "node --experimental-strip-types scripts/complexity-collect.ts",
    "complex:report": "node --experimental-strip-types scripts/complexity-report.ts"
  },
  "dependencies": {
    "@tanstack/react-form": "catalog:"
  },
  "devDependencies": {
    "@changesets/changelog-git": "catalog:",
    "@changesets/cli": "catalog:",
    "@workspace/typescript-config": "workspace:*",
    "eslint-plugin-sonarjs": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-plugin-eslint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "pkg-pr-new": "catalog:",
    "ts-api-utils": "catalog:",
    "turbo": "^2.10.4",
    "typescript": "catalog:",
    "zod": "catalog:"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@11.0.0",
  "pnpm": {
    "overrides": {
      "@types/react": "^19.2.17",
      "@types/react-dom": "^19.2.3"
    }
  }
}
